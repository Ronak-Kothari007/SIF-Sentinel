# Environment variables for SIF Sentinel backend (local development)
# Copy this file to .env and fill in values.
# .env is git-ignored — never commit secrets.

# Application
ENVIRONMENT=development

# CORS — frontend dev server origins (comma-separated list in config.py)
# No changes needed for local dev.

# Phase 2 will add:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sif_sentinel
# SECRET_KEY=your-secret-key-here
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
